# ============================================================================
# Contour — AI Travel Itinerary Builder
# Copy to .env.local and fill in. NEVER commit the filled file.
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is
# server-only and must be read exclusively inside /app/api routes.
# ============================================================================

# ---- Neon (the live store — see database/schema.neon.sql) ------------------
# Neon Console -> your project -> Connection string. Pooled host for serverless.
# This role is neondb_owner, which OWNS the tables and therefore BYPASSES RLS.
# Server-side only. It is the service path; never let it reach the browser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Unpooled, for migrations and anything needing a session (advisory locks etc.)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Neon Auth (Stack Auth) ------------------------------------------------
# Neon Console -> Auth. The project id and publishable key are client-visible by
# design; the secret server key is not.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Queries that must be filtered by RLS connect as the "authenticated" role and
# carry the user's JWT, e.g. neon(DATABASE_AUTHENTICATED_URL, { authToken }).
# Without a JWT current_user_id() is null and every policy denies.
DATABASE_AUTHENTICATED_URL=postgresql://authenticated@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Supabase (legacy — only if you run database/schema.sql instead) --------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS. Server-side only — if this ever appears in a
# client bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider -----------------------------------------------------------
# Used by /api/trips/:id/generate, /regenerate, /optimize and /api/assistant
AI_API_KEY=
AI_PROVIDER=anthropic          # anthropic | openai | ... (see lib/services/ai)
AI_MODEL=

# ---- Routing / directions --------------------------------------------------
# Distances, durations, polylines, overnight-halt selection
MAPS_API_KEY=
MAPS_PROVIDER=google           # google | mapbox | ors

# Client-side map rendering token (public by design — restrict it by HTTP
# referrer in the provider console)
NEXT_PUBLIC_MAP_TILES_TOKEN=

# ---- Weather ---------------------------------------------------------------
WEATHER_API_KEY=
WEATHER_PROVIDER=openweather   # openweather | weatherapi | tomorrow

# ---- Places / POI ----------------------------------------------------------
# Attractions, restaurants, fuel stations, parking
PLACES_API_KEY=
PLACES_PROVIDER=google         # google | foursquare | overpass

# ---- Hotels (optional) -----------------------------------------------------
# If unset, the hotels service returns AI price-band suggestions with
# verified = false and the UI labels them accordingly.
HOTELS_API_KEY=
HOTELS_PROVIDER=

# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Contour

# ---- Cache TTLs in seconds (server-side api_cache table) -------------------
CACHE_TTL_ROUTING=2592000      # 30 days  — road geometry barely moves
CACHE_TTL_PLACES=604800        # 7 days
CACHE_TTL_WEATHER=3600         # 1 hour
CACHE_TTL_HOTELS=21600         # 6 hours
CACHE_TTL_AI=0                 # do not cache generations

# ---- Rate limiting (optional) ----------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
