# ============================================================================
# Contour — copy to .env.local and fill in. NEVER commit the filled file.
# Only NEXT_PUBLIC_* variables reach the browser.
#
# Nothing a user enters is stored on a server. There is no database, and these
# variables reflect that: a signing secret, and a way to deliver one-time codes.
# ============================================================================



# ---- App -------------------------------------------------------------------
# Only set this if a proxy misreports the host. The OAuth redirect URI is
# normally derived from the incoming request, which is why it is NOT a
# NEXT_PUBLIC_ value — those are inlined at build time and would freeze the
# redirect URI to the build machine's host.
# APP_ORIGIN=https://your-domain.com


# ---- Travel data providers -------------------------------------------------
# The planner works with NO keys at all. Routing (OSRM), geocoding (Nominatim)
# and weather (Open-Meteo) are free and need none, and they are what produce the
# verified distance, duration and forecast.
#
# Places are the exception. The keyless fallback is Overpass (OpenStreetMap),
# and it was measured against a real 636 km route: the public mirrors timed out
# at 70 seconds on an eight-point query, so most stops came back with no venue.
# The planner then says "Live data unavailable" rather than inventing one.
#
# For real restaurants, fuel stops and hotels at every stop, set a Google Places
# key. Google Cloud Console -> APIs & Services -> Library -> "Places API (New)"
# -> Enable, then Credentials -> Create credentials -> API key. Restrict it to
# the Places API. Read server-side only; it never reaches the browser.
GOOGLE_PLACES_API_KEY=

# ---- Supabase (backend of record) -------------------------------------------
# Supabase holds trips, itineraries, budgets and expenses. Row Level Security is
# enabled on every table, so the database — not the app — decides who sees what.
#
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bypasses RLS completely. Server-side only, never prefixed NEXT_PUBLIC_, and
# never imported from a client component — lib/supabase/server.ts is marked
# `server-only` so attempting it is a build error rather than a leak.
SUPABASE_SERVICE_ROLE_KEY=
