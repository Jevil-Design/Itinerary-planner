# ============================================================================
# Contour — copy to .env.local and fill in. NEVER commit the filled file.
# Only NEXT_PUBLIC_* variables reach the browser.
#
# Nothing a user enters is stored on a server. There is no database, and these
# variables reflect that: a signing secret, and a way to deliver one-time codes.
# ============================================================================

# ---- Sign-in (one-time code) -----------------------------------------------
# Signs the OTP challenge and the session cookie. No storage is involved, so
# this secret IS the security boundary — rotate it to invalidate every session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- Email delivery --------------------------------------------------------
# Without these, /api/auth/otp/request refuses with a clear message rather than
# pretending a code was sent. https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM="Contour <login@yourdomain.com>"

# ---- App -------------------------------------------------------------------
# Only set this if a proxy misreports the host. The OAuth redirect URI is
# normally derived from the incoming request, which is why it is NOT a
# NEXT_PUBLIC_ value — those are inlined at build time and would freeze the
# redirect URI to the build machine's host.
# APP_ORIGIN=https://your-domain.com

# ---- Google sign-in --------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → Web application. Authorised redirect URI must be, exactly:
#   https://YOUR-DOMAIN/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback   (for local development)
# Without these the Google button reports that it is not set up, rather than
# failing silently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
